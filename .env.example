# Environment Configuration for Versaly Core
# Copy to .env.local for local development. Never commit real values.

# Database (PostgreSQL)
# Matches docker-compose.yml defaults for local dev. On Vercel, connecting Neon
# (Storage tab) sets DATABASE_URL and DATABASE_URL_UNPOOLED automatically;
# `vercel env pull .env.local` copies them here for local development.
DATABASE_URL="postgresql://versaly:versaly_dev_password@localhost:5432/versaly_core?schema=public"
# DATABASE_URL_UNPOOLED=""   # direct connection, used for migrations

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security — REQUIRED in production (the app refuses to sign anyone in without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Owner login (no database needed). Set both with: npm run owner:password
OWNER_EMAIL=""
OWNER_PASSWORD_HASH=""
# OWNER_NAME="Your Name"

# M-Pesa (Safaricom Daraja) callback secret: a long random string used in the callback URL.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MPESA_CALLBACK_SECRET=""
