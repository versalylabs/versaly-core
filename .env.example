# Environment Configuration for Versaly Core

# Database (PostgreSQL)
# Matches docker-compose.yml defaults for local dev
DATABASE_URL="postgresql://versaly:versaly_dev_password@localhost:5432/versaly_core?schema=public"

# App & Security
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="versaly_core_dev_secret_key_change_in_production_min_32_chars"
NODE_ENV="development"
