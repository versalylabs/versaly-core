# Environment Configuration for Versaly Core
# Copy to .env.local for local development. Never commit real values.

# Database (PostgreSQL)
# Matches docker-compose.yml defaults for local dev. On Vercel, connecting Neon
# (Storage tab) sets DATABASE_URL and DATABASE_URL_UNPOOLED automatically;
# `vercel env pull .env.local` copies them here for local development.
DATABASE_URL="postgresql://versaly:versaly_dev_password@localhost:5432/versaly_core?schema=public"
# DATABASE_URL_UNPOOLED=""   # direct connection, used for migrations

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security — REQUIRED in production (the app refuses to sign anyone in without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Owner login (no database needed). Set both with: npm run owner:password
OWNER_EMAIL=""
OWNER_PASSWORD_HASH=""
# OWNER_NAME="Your Name"

# M-Pesa (Safaricom Daraja) callback secret: a long random string used in the callback URL.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MPESA_CALLBACK_SECRET=""

# Weekly review email (sent Fridays by Vercel Cron; see vercel.json)
# RESEND_API_KEY: from https://resend.com (the free tier is enough).
# EMAIL_FROM: leave blank to use Resend's test sender, which only delivers to your own Resend account email,
#   or set e.g. "Versaly Core <reports@yourdomain.com>" after verifying your domain.
RESEND_API_KEY=""
EMAIL_FROM=""
WEEKLY_REVIEW_TO=""
# CRON_SECRET: a long random string; Vercel sends it so only Vercel can trigger the job.
CRON_SECRET=""

# AI assistant (Assistant page). Without a key the page falls back to a simple keyword lookup.
# ANTHROPIC_API_KEY: create one at https://console.anthropic.com (set it on Vercel with: npm run ai:setup).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL: defaults to claude-opus-5-5. Use claude-sonnet-5-5 for a cheaper, faster assistant.
# ANTHROPIC_MODEL=""
# ASSISTANT_DAILY_LIMIT: most questions across the whole team per 24 hours (default 300), a guard on the bill.
# ASSISTANT_DAILY_LIMIT=300
