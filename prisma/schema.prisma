datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum OrganizationType {
  CLIENT
  PROSPECT
  PARTNER
  VENDOR
  OTHER
}

enum ContactType {
  PRIMARY
  DECISION_MAKER
  BILLING
  TECHNICAL
  OPERATIONAL
  OTHER
}

enum DocumentCategory {
  CONTRACT
  PROPOSAL
  SALES_SHEET
  ONBOARDING_KIT
  TECHNICAL_SPEC
  FINANCIAL
  INTERNAL_SOP
  OTHER
}

enum DealStage {
  CONTACTED
  DEMO_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  BLOCKED
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  name         String
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  jobTitle     String?
  phone        String?

  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @default("Versaly")
  legalName   String?
  email       String?
  phone       String?
  website     String?
  address     String?
  timezone    String   @default("Africa/Nairobi")
  currency    String   @default("KES")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  tagline        String?
  description    String?
  category       String?
  setupFee       Float    @default(0)
  monthlyFee     Float    @default(0)
  pricingModel   String?
  guaranteeOffer String?
  features       String[]
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  type          OrganizationType     @default(PROSPECT)
  industry      String?
  website       String?
  address       String?
  city          String?              @default("Nairobi")
  phone         String?
  email         String?
  taxPin        String?
  status        String               @default("ACTIVE")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  contacts      Person[]
  activities    ActivityLog[]
  deals         Deal[]
  subscriptions ClientSubscription[]
  projects      Project[]
  invoices      Invoice[]

  @@index([name])
  @@index([type])
  @@index([status])
}

model Person {
  id             String        @id @default(cuid())
  organizationId String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  whatsapp       String?
  jobTitle       String?
  contactType    ContactType   @default(PRIMARY)
  isPrimary      Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activities     ActivityLog[]
  deals          Deal[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model RawLead {
  id           String   @id @default(cuid())
  businessName String
  contactName  String?
  phone        String?
  whatsapp     String?
  email        String?
  productSlug  String
  location     String?
  source       String   // Walk-in, Referral, Cold Email, WhatsApp, Social
  notes        String?
  status       String   @default("UNCONTACTED") // UNCONTACTED, CONTACTED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productSlug])
  @@index([status])
}

model Deal {
  id              String    @id @default(cuid())
  organizationId  String?
  contactId       String?
  productSlug     String
  stage           DealStage @default(CONTACTED)
  setupFeeKES     Float     @default(0)
  monthlyFeeKES   Float     @default(0)
  winProbability  Int       @default(30)
  targetCloseDate DateTime?
  outreachChannel String?
  lostReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact         Person?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([productSlug])
  @@index([stage])
  @@index([organizationId])
}

model ClientSubscription {
  id                    String        @id @default(cuid())
  organizationId        String
  productSlug           String
  mrrKES                Float         @default(0)
  status                String        @default("ONBOARDING") // ONBOARDING, ACTIVE, PAST_DUE, CANCELLED
  renewalDate           DateTime?
  onboardingProgressPct Int           @default(0)
  currentOnboardingStep Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects              Project[]

  @@index([organizationId])
  @@index([productSlug])
  @@index([status])
}

model Project {
  id                   String              @id @default(cuid())
  clientSubscriptionId String?
  organizationId       String
  name                 String
  productSlug          String
  status               ProjectStatus       @default(ACTIVE)
  leadArchitect        String              @default("Ted (Ops)")
  targetGoLiveDate     DateTime?
  progressPct          Int                 @default(0)
  hasBlocker           Boolean             @default(false)
  blockerDescription   String?
  blockerDays          Int?                @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  tasks                ProjectTask[]

  @@index([organizationId])
  @@index([productSlug])
  @@index([status])
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  stepNumber  Int?
  title       String
  description String?
  assignedTo  String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([completed])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  personId       String?
  userId         String?
  type           String        // CALL, VISIT, WHATSAPP, EMAIL, MEETING, NOTE, STATUS_CHANGE
  title          String
  description    String?
  outcome        String?
  nextActionDate DateTime?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([personId])
  @@index([createdAt])
}

model Document {
  id           String           @id @default(cuid())
  title        String
  fileName     String
  fileSize     Int              @default(0)
  mimeType     String           @default("application/pdf")
  fileUrl      String
  category     DocumentCategory @default(OTHER)
  version      Int              @default(1)
  tags         String[]
  entityType   String?
  entityId     String?
  productSlug  String?
  uploadedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([category])
  @@index([entityType, entityId])
  @@index([productSlug])
}

model DocumentTemplate {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  category    DocumentCategory @default(CONTRACT)
  productSlug String?
  version     Int              @default(1)
  variables   String[]
  content     String
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([slug])
  @@index([category])
  @@index([productSlug])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum KnowledgeCategory {
  SOP_PLAYBOOK
  TECHNICAL_RUNBOOK
  OBJECTION_PLAYBOOK
  PRODUCT_FAQ
  DECISION_RECORD
  COMPETITOR_INTEL
}

model KnowledgeArticle {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  category        KnowledgeCategory @default(SOP_PLAYBOOK)
  productSlug     String?           // Linked to Adversoft, Vehisoft, etc. or general
  summary         String
  contentMarkdown String
  authorName      String            @default("Versaly Core Ops")
  version         Int               @default(1)
  tags            String[]
  isVerified      Boolean           @default(true)
  nextReviewDate  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  checklists      SOPChecklist[]

  @@index([slug])
  @@index([category])
  @@index([productSlug])
}

model SOPChecklist {
  id          String            @id @default(cuid())
  articleId   String
  stepOrder   Int
  title       String
  description String?
  roleScope   String            @default("Technical Lead / Ops")
  createdAt   DateTime          @default(now())

  article     KnowledgeArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([stepOrder])
}

model DecisionRecord {
  id          String    @id @default(cuid())
  adrNumber   Int       @unique
  title       String
  status      String    @default("ACCEPTED") // PROPOSED, ACCEPTED, SUPERSEDED, REJECTED
  context     String
  decision    String
  consequences String
  productSlug String?
  decidedBy   String    @default("Ted (Founder)")
  decidedAt   DateTime  @default(now())

  @@index([adrNumber])
  @@index([status])
  @@index([productSlug])
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PAID
  VOID
}

enum PaymentChannel {
  MPESA_PAYBILL
  MPESA_TILL
  MPESA_STK
  BANK_TRANSFER
  CASH
  CHEQUE
}

enum ExpenseCategory {
  INFRASTRUCTURE_CLOUD
  HARDWARE_DEVICES
  FIELD_CREW_TRANSPORT
  OFFICE_UTILITIES
  MARKETING_ADS
  LEGAL_COMPLIANCE
  SALARIES_COMMISSIONS
}

model Invoice {
  id              String             @id @default(cuid())
  invoiceNumber   String             @unique // e.g. INV-2026-0042
  organizationId  String
  clientName      String
  productSlug     String
  status          InvoiceStatus      @default(SENT)
  subtotalKES     Float
  taxKES          Float              @default(0) // eTIMS VAT 16% if applicable
  totalKES        Float
  amountPaidKES   Float              @default(0)
  balanceKES      Float
  dueDate         DateTime
  issueDate       DateTime           @default(now())
  paidAt          DateTime?
  notes           String?
  kraEtimsQrCode  String?            // Cryptographic fiscal string
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems       InvoiceLineItem[]
  payments        PaymentTransaction[]

  @@index([organizationId])
  @@index([productSlug])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  amountKES   Float
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentTransaction {
  id              String         @id @default(cuid())
  invoiceId       String
  referenceNumber String         // M-Pesa receipt code e.g. 'RJK84920KL' or Bank wire ref
  channel         PaymentChannel @default(MPESA_PAYBILL)
  amountKES       Float
  payerName       String?
  payerPhone      String?
  receivedAt      DateTime       @default(now())
  reconciled      Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now())

  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([referenceNumber])
  @@index([channel])
}

model BusinessExpense {
  id          String          @id @default(cuid())
  category    ExpenseCategory @default(INFRASTRUCTURE_CLOUD)
  description String
  amountKES   Float
  vendor      String
  receiptUrl  String?
  expenseDate DateTime        @default(now())
  productSlug String?         // If directly attributable to a product (e.g. GPS trackers for Vehisoft)
  createdAt   DateTime        @default(now())

  @@index([category])
  @@index([expenseDate])
  @@index([productSlug])
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AutomationTriggerType {
  DEAL_WON
  INVOICE_OVERDUE
  PROJECT_BLOCKED
  CLIENT_RENEWAL_30D
  OUTREACH_TASK_DUE
}

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  title       String
  message     String
  priority    NotificationPriority @default(MEDIUM)
  linkUrl     String?
  entityType  String?              // DEAL, INVOICE, PROJECT, CLIENT
  entityId    String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([priority])
  @@index([createdAt])
}

model AutomationRule {
  id              String                @id @default(cuid())
  name            String
  triggerType     AutomationTriggerType
  description     String
  actionSummary   String
  isActive        Boolean               @default(true)
  lastTriggeredAt DateTime?
  executionCount  Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([triggerType])
  @@index([isActive])
}

// ============================================================================
// VERSALY FINANCIAL MANAGEMENT ENGINE
// ============================================================================

enum AccountType {
  BANK_CHECKING
  BANK_SAVINGS
  MPESA_PAYBILL
  MPESA_TILL
  PETTY_CASH
  RESERVE_ESCROW
}

model CompanyAccount {
  id            String      @id @default(cuid())
  name          String      // e.g. "KCB Corporate Checking", "Safaricom Paybill 408221", "M-Pesa Till 89201"
  accountType   AccountType @default(BANK_CHECKING)
  accountNumber String      // e.g. "1284920491", "408221"
  institution   String      // "KCB Bank Kenya", "Equity Bank", "Safaricom M-Pesa", "NCBA", "Internal Vault"
  currency      String      @default("KES")
  balanceKES    Float       @default(0)
  isDefault     Boolean     @default(false)
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ledgerEntries FinancialLedgerEntry[]

  @@index([accountType])
  @@index([status])
}

enum LedgerEntryType {
  DEBIT  // Cash out
  CREDIT // Cash in
}

model FinancialLedgerEntry {
  id              String          @id @default(cuid())
  accountId       String
  date            DateTime        @default(now())
  entryType       LedgerEntryType
  amountKES       Float
  balanceAfterKES Float           @default(0)
  category        String          // e.g. "CLIENT_PAYMENT", "CAPITAL_CONTRIBUTION", "OPERATIONAL_EXPENSE", "SALARY", "RESERVE_TRANSFER"
  description     String
  reference       String?         // Transaction ref, e.g. M-Pesa code, Bank wire ref, Invoice No
  reconciled      Boolean         @default(true)
  reconciledAt    DateTime?
  reconciledBy    String?
  entityType      String?         // INVOICE, EXPENSE, CAPITAL, LOAN, COMPENSATION, RESERVE
  entityId        String?
  notes           String?
  createdAt       DateTime        @default(now())

  account         CompanyAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@index([category])
  @@index([reference])
}

enum CapitalContributionType {
  EQUITY_CAPITAL
  SHAREHOLDER_LOAN
  REIMBURSABLE_EXPENSE
  GRANT_SUBSIDY
  OTHER
}

model CapitalContribution {
  id              String                  @id @default(cuid())
  contributorName String                  // e.g. "Ted (Founder & CEO)", "Co-Founder", "Angel Investor"
  amountKES       Float
  contributionDate DateTime               @default(now())
  type            CapitalContributionType @default(EQUITY_CAPITAL)
  status          String                  @default("RECEIVED") // RECEIVED, PENDING, REIMBURSED
  supportingDoc   String?                 // Legal document URL, investment agreement ref
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  loan            ShareholderLoan?

  @@index([type])
  @@index([status])
}

model ShareholderLoan {
  id                    String              @id @default(cuid())
  contributionId        String              @unique
  lenderName            String
  principalAmountKES    Float
  interestRateAnnualPct Float               @default(0)
  startDate             DateTime            @default(now())
  maturityDate          DateTime?
  repaymentTermMonths   Int                 @default(12)
  amountRepaidKES       Float               @default(0)
  remainingBalanceKES   Float
  status                String              @default("ACTIVE") // ACTIVE, FULLY_REPAID, DEFAULTED, RENEGOTIATED
  repaymentSchedule     Json?               // Monthly repayment schedule items
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  contribution          CapitalContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model EquityScenario {
  id              String   @id @default(cuid())
  scenarioName    String   // e.g. "Proposed Pre-Seed Split", "Legally Issued Founding Cap Table"
  isLegallyIssued Boolean  @default(false) // Strict guardrail: distinguishes proposed scenarios from legal reality
  totalAuthorizedShares Int @default(1000000)
  totalIssuedShares     Int @default(100000)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stakeholders    Shareholding[]
}

model Shareholding {
  id                  String         @id @default(cuid())
  scenarioId          String
  shareholderName     String
  roleTitle           String         // "Founder & CEO", "Co-Founder & CTO", "Strategic Partner"
  percentage          Float          // e.g. 51.0, 29.0, 20.0
  sharesCount         Int            @default(0)
  shareClass          String         @default("ORDINARY_A") // ORDINARY_A, ORDINARY_B, PREFERRED
  vestingMonths       Int            @default(48)
  cliffMonths         Int            @default(12)
  vestingStartDate    DateTime       @default(now())
  isLegallyBinding    Boolean        @default(false)
  votingRights        Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  scenario            EquityScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
  NINETY_DAY_STARTUP
}

model BudgetPlan {
  id              String       @id @default(cuid())
  name            String       // e.g. "90-Day Startup Launch Budget", "Q4 2026 Operational Budget"
  period          BudgetPeriod @default(NINETY_DAY_STARTUP)
  year            Int          @default(2026)
  quarter         Int?
  month           Int?
  totalBudgetKES  Float
  status          String       @default("APPROVED") // DRAFT, SUBMITTED, APPROVED, ARCHIVED
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           BudgetItem[]

  @@index([period])
  @@index([year])
  @@index([status])
}

model BudgetItem {
  id            String     @id @default(cuid())
  budgetId      String
  category      String     // e.g. "Registration & Legal", "Hosting & Software", "Sales Outreach"
  allocatedKES  Float
  spentKES      Float      @default(0)
  department    String     @default("Operations") // Operations, Engineering, Sales, Marketing, Admin
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  budget        BudgetPlan @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([department])
}

model VendorSubscription {
  id              String   @id @default(cuid())
  provider        String   // "Vercel", "OpenAI", "AWS", "Google Workspace", "GitHub", "Safaricom Daraja"
  serviceName     String   // "Pro Hosting & Analytics", "GPT-4o API Retainer", "Domain Renewals"
  category        String   @default("CLOUD_INFRASTRUCTURE")
  costAmount      Float
  currency        String   @default("KES")
  costKES         Float    // Normalized to KES
  billingCycle    String   @default("MONTHLY") // MONTHLY, ANNUAL, QUARTERLY
  renewalDate     DateTime
  paymentMethod   String   @default("CARD") // CARD, MPESA, BANK_TRANSFER
  responsiblePerson String @default("Ted (Founder)")
  status          String   @default("ACTIVE") // ACTIVE, REVIEW_FOR_CANCEL, CANCELLED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([renewalDate])
}

model CashReserveFund {
  id                 String   @id @default(cuid())
  fundName           String   // "Emergency Operating Reserve", "KRA Tax Provision", "Infrastructure Fund", "Growth & Marketing"
  targetKES          Float
  currentAllocatedKES Float   @default(0)
  targetMonthsRunway Int      @default(3)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([fundName])
}

enum CompensationType {
  SALARY
  COMMISSION
  CONTRACTOR_FEE
  REIMBURSEMENT
  SHAREHOLDER_LOAN_REPAYMENT
  DIVIDEND_DISTRIBUTION
}

model CompensationRecord {
  id              String           @id @default(cuid())
  recipientName   String
  roleTitle       String
  type            CompensationType @default(SALARY)
  amountKES       Float
  paymentDate     DateTime         @default(now())
  paymentMethod   String           @default("MPESA") // MPESA_B2C, BANK_TRANSFER, CASH
  status          String           @default("PAID") // PENDING_APPROVAL, APPROVED, PAID, CANCELLED
  approvedBy      String?
  approvalDate    DateTime?
  periodCovered   String           // e.g. "October 2026", "Deal #deal-vehisoft-10"
  referenceNumber String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type])
  @@index([status])
}

