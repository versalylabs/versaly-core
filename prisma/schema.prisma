datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum OrganizationType {
  CLIENT
  PROSPECT
  PARTNER
  VENDOR
  OTHER
}

enum ContactType {
  PRIMARY
  DECISION_MAKER
  BILLING
  TECHNICAL
  OPERATIONAL
  OTHER
}

enum DocumentCategory {
  CONTRACT
  PROPOSAL
  SALES_SHEET
  ONBOARDING_KIT
  TECHNICAL_SPEC
  FINANCIAL
  INTERNAL_SOP
  OTHER
}

enum DealStage {
  CONTACTED
  DEMO_BOOKED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  name         String
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  jobTitle     String?
  phone        String?

  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @default("Versaly")
  legalName   String?
  email       String?
  phone       String?
  website     String?
  address     String?
  timezone    String   @default("Africa/Nairobi")
  currency    String   @default("KES")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  tagline        String?
  description    String?
  category       String?
  setupFee       Float    @default(0)
  monthlyFee     Float    @default(0)
  pricingModel   String?
  guaranteeOffer String?
  features       String[]
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType @default(PROSPECT)
  industry    String?
  website     String?
  address     String?
  city        String?          @default("Nairobi")
  phone       String?
  email       String?
  taxPin      String?
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  contacts    Person[]
  activities  ActivityLog[]
  deals       Deal[]

  @@index([name])
  @@index([type])
  @@index([status])
}

model Person {
  id             String        @id @default(cuid())
  organizationId String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  whatsapp       String?
  jobTitle       String?
  contactType    ContactType   @default(PRIMARY)
  isPrimary      Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activities     ActivityLog[]
  deals          Deal[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model RawLead {
  id           String   @id @default(cuid())
  businessName String
  contactName  String?
  phone        String?
  whatsapp     String?
  email        String?
  productSlug  String
  location     String?
  source       String   // Walk-in, Referral, Cold Email, WhatsApp, Social
  notes        String?
  status       String   @default("UNCONTACTED") // UNCONTACTED, CONTACTED, ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productSlug])
  @@index([status])
}

model Deal {
  id              String    @id @default(cuid())
  organizationId  String?
  contactId       String?
  productSlug     String
  stage           DealStage @default(CONTACTED)
  setupFeeKES     Float     @default(0)
  monthlyFeeKES   Float     @default(0)
  winProbability  Int       @default(30)
  targetCloseDate DateTime?
  outreachChannel String?
  lostReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact         Person?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([productSlug])
  @@index([stage])
  @@index([organizationId])
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  personId       String?
  userId         String?
  type           String        // CALL, VISIT, WHATSAPP, EMAIL, MEETING, NOTE, STATUS_CHANGE
  title          String
  description    String?
  outcome        String?
  nextActionDate DateTime?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([personId])
  @@index([createdAt])
}

model Document {
  id           String           @id @default(cuid())
  title        String
  fileName     String
  fileSize     Int              @default(0)
  mimeType     String           @default("application/pdf")
  fileUrl      String
  category     DocumentCategory @default(OTHER)
  version      Int              @default(1)
  tags         String[]
  entityType   String?
  entityId     String?
  productSlug  String?
  uploadedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([category])
  @@index([entityType, entityId])
  @@index([productSlug])
}

model DocumentTemplate {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  category    DocumentCategory @default(CONTRACT)
  productSlug String?
  version     Int              @default(1)
  variables   String[]
  content     String
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([slug])
  @@index([category])
  @@index([productSlug])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
